{
  "kind": "PrometheusDatasource",
  "spec": {
    "directUrl": "http://localhost:9090",
    "exemplars": {
      "enable": true,
      "links": [
        {
          "name": "Jaeger",
          "url": "http://localhost:16686/trace/${traceId}",
          "traceIDLabel": "trace_id"
        },
        {
          "url": "https://tempo.example.com/trace/${traceId}",
          "traceIDLabel": "traceID"
        }
      ]
    }
  }
}
