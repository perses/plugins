{
  "kind": "Dashboard",
  "metadata": {
    "name": "CanvasGraphDemo",
    "project": "perses"
  },
  "spec": {
    "display": {
      "name": "Canvas – Data-driven graph demo"
    },
    "duration": "5m",
    "panels": {
      "topology": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Host topology (generated from data)",
            "description": "Nodes come from node_load (id label: instance); edges come from edge_traffic (labels: source, target). Node captions use the name/role/region labels; colors and edge thickness follow the thresholds."
          },
          "plugin": {
            "kind": "Canvas",
            "spec": {
              "thresholds": {
                "steps": [
                  { "value": 0.5, "color": "#f9a825" },
                  { "value": 0.8, "color": "#d32f2f" }
                ]
              },
              "edgeThresholds": {
                "defaultColor": "#90caf9",
                "steps": [
                  { "value": 0.5, "color": "#5c6bc0" },
                  { "value": 0.8, "color": "#6a1b9a" }
                ]
              },
              "edgeThresholdWidths": [
                { "value": 0.5, "strokeWidth": 4 },
                { "value": 0.8, "strokeWidth": 8 }
              ],
              "nodeThresholdSizes": [
                { "value": 0.5, "scale": 1.3 },
                { "value": 0.8, "scale": 1.7 }
              ],
              "nodeDefaultSize": 44,
              "format": { "unit": "decimal" },
              "legend": { "position": "bottom" },
              "graphGeneration": {
                "enabled": true,
                "nodeQueryIndex": 0,
                "nodeIdLabel": "instance",
                "nodeLabelTemplate": "{{name}} · {{value}}",
                "edgeQueryIndex": 1,
                "edgeSourceLabel": "source",
                "edgeTargetLabel": "target",
                "edgeLabelTemplate": "{{value}}"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "node_load"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "edge_traffic"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/topology"
              }
            }
          ]
        }
      }
    ]
  }
}
