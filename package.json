{
  "name": "perses-plugins",
  "description": "Monorepo for the Perses plugins",
  "version": "0.1.0",
  "homepage": "https://github.com/perses/plugins/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/perses/plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --workspace-concurrency=20 --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint -- --fix",
    "format": "pnpm run format:root",
    "format:check": "pnpm run format:root:check",
    "format:root": "oxfmt",
    "format:root:check": "oxfmt --check",
    "test": "pnpm -r --if-present run test",
    "type-check": "pnpm -r --if-present run type-check",
    "doctor": "pnpm dlx react-doctor@latest"
  },
  "workspaces": [
    "alertmanager",
    "barchart",
    "clickhouse",
    "datasourcevariable",
    "flamechart",
    "gaugechart",
    "greptimedb",
    "heatmapchart",
    "histogramchart",
    "jaeger",
    "logexplorer",
    "logstable",
    "loki",
    "markdown",
    "opensearch",
    "piechart",
    "prometheus",
    "pyroscope",
    "scatterchart",
    "statchart",
    "staticlistvariable",
    "statushistorychart",
    "splunk",
    "table",
    "tempo",
    "timeserieschart",
    "timeseriestable",
    "tracetable",
    "tracingganttchart",
    "victorialogs",
    "e2e"
  ],
  "peerDependencies": {
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.6.0",
    "@perses-dev/client": "^0.55.0-beta.7",
    "@perses-dev/components": "^0.55.0-beta.7",
    "@perses-dev/dashboards": "^0.55.0-beta.7",
    "@perses-dev/explore": "^0.55.0-beta.7",
    "@perses-dev/plugin-system": "^0.55.0-beta.7",
    "@perses-dev/spec": "^0.3.0-beta.5",
    "@rsbuild/core": "^1.6.7",
    "@rsbuild/plugin-react": "^1.4.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/color-hash": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.20",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "express": "^4.21.2",
    "jsdom": "^27.0.0",
    "mdi-material-ui": "^7.9.2",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "rsbuild-plugin-dts": "^0.18.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.1.0"
}
