{
  "name": "@perses-dev/log-explorer-plugin",
  "version": "0.2.0-beta.1",
  "homepage": "https://github.com/perses/plugins/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/perses/plugins/issues"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "oxlint src",
    "test": "cross-env LC_ALL=C TZ=UTC vitest run",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@types/qs": "^6.9.18"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@hookform/resolvers": "^3.2.0",
    "@perses-dev/components": "^0.55.0-beta.3",
    "@perses-dev/dashboards": "^0.55.0-beta.6",
    "@perses-dev/explore": "^0.55.0-beta.6",
    "@perses-dev/plugin-system": "^0.55.0-beta.6",
    "@perses-dev/spec": "^0.3.0-beta.5",
    "@tanstack/react-query": "^4.39.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "5.5.0",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.2",
    "react-router-dom": "^5 || ^6 || ^7"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "perses": {
    "moduleName": "LogExplorer",
    "moduleOrg": "perses.dev",
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "Explore",
        "spec": {
          "display": {
            "name": "Log Explorer"
          },
          "name": "LogExplorer"
        }
      }
    ]
  }
}
