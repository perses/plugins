{
  "name": "@perses-dev/azure-plugin",
  "version": "0.1.0-beta.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/plugins/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/perses/plugins/issues"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "oxlint src",
    "test": "cross-env LC_ALL=C TZ=UTC vitest run",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@perses-dev/components": "^0.56.0-beta.1",
    "@perses-dev/plugin-system": "^0.56.0-beta.1",
    "@perses-dev/client": "^0.56.0-beta.1",
    "@perses-dev/spec": "^0.3.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {},
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "perses": {
    "schemasPath": "schemas",
    "metadata": {
      "name": "Azure",
      "registry": "perses-dev"
    },
    "plugins": [
      {
        "kind": "Datasource",
        "spec": {
          "display": {
            "name": "Azure Resource Manager Datasource"
          },
          "name": "AzureResourceManagerDatasource"
        }
      },
      {
        "kind": "JsonQuery",
        "spec": {
          "display": {
            "name": "Azure Resource Graph KQL Query"
          },
          "name": "AzureResourceGraphKqlQuery"
        }
      },
      {
        "kind": "Variable",
        "spec": {
          "display": {
            "name": "Azure Resource Graph KQL Variable"
          },
          "name": "AzureResourceGraphKqlVariable"
        }
      },
      {
        "kind": "Datasource",
        "spec": {
          "display": {
            "name": "Azure Regional Metrics Datasource"
          },
          "name": "AzureRegionalMetricsDatasource"
        }
      },
      {
        "kind": "TimeSeriesQuery",
        "spec": {
          "display": {
            "name": "Azure Metrics Batch Query"
          },
          "name": "AzureMetricsBatchQuery"
        }
      }
    ]
  }
}
